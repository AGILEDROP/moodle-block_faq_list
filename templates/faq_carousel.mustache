{{!
    @template block_faq_list/faq_carousel

    This template renders faq list as a carousel.

    Example context (json):
    {
        "show_title": true,
        "faq_title": "FAQ Block Title",
        "blockid": 12,
        "faq_items": [
            {
                "itemnumber": 0,
                "id": 5,
                "question": "Question?",
                "answer": "<p>Answer.</p>"
            }
        ]
    }
}}
<div class="faq-wrapper">
    {{#show_title}}
        <h2>{{{faq_title}}}</h2>
    {{/show_title}}

    <div id="faq-carousel-{{{blockid}}}" class="carousel pb-6 slide" data-bs-ride="carousel">
        <div class="carousel-indicators">
            {{#faq_items}}
                <button type="button" data-bs-target="#faq-carousel-{{{blockid}}}" data-bs-slide-to="{{itemnumber}}" class="{{^itemnumber}}active{{/itemnumber}}" {{^itemnumber}}aria-current="true"{{/itemnumber}} aria-label="{{{question}}}"></button>
            {{/faq_items}}
        </div>

        <div class="carousel-inner">
          {{#faq_items}}
              <div class="carousel-item {{^itemnumber}}active{{/itemnumber}}">
                  <div class="card dashboard-card">
                      <h5 class="card-title">{{{question}}}</h5>
                      <div class="card-body">{{{answer}}}</div>
                  </div>
              </div>
          {{/faq_items}}
        </div>
    </div>
</div>
